# Variáveis de Ambiente do Supabase - PlantãoPS
# Copie este arquivo para .env e preencha com as credenciais do seu projeto no Supabase (Settings > API)
# ATENÇÃO: NUNCA utilize a chave service_role no frontend! Use apenas a chave anon (public).

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
